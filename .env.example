# --- SquishyGPT environment ---
# Copy to .env.local for local dev. On Railway, set these as service variables.

# Postgres connection string (Railway Postgres provides this automatically).
DATABASE_URL=postgresql://user:password@localhost:5432/squishygpt

# Set to "disable" only for a local Postgres without SSL.
# PGSSL=disable

# Anthropic (Claude) — powers the chat answers.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: override the Claude model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI — used only for embeddings (RAG retrieval).
OPENAI_API_KEY=sk-xxxxxxxx
# Optional: defaults to text-embedding-3-small (1536 dims).
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Single shared password to access the site (just for Serena).
SITE_PASSWORD=change-me-to-something-only-serena-knows

# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET=generate-a-long-random-string-here

# --- Redeem alerts ---
# When Serena redeems a reward in the Paw Shop, ping Ashrit over any channel
# configured below. Leave a section blank to disable that channel. If none are
# set, the redeem still works but no notification is sent (a warning is logged).

# SMS via Twilio (needs a Twilio account, a Message-capable number, and creds).
# Numbers must be E.164 format.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
ALERT_PHONE_NUMBER=+18569813997

# Slack incoming webhook (https://api.slack.com/messaging/webhooks).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email via Resend (https://resend.com).
# RESEND_API_KEY=re_xxxxxxxx
# ALERT_EMAIL_TO=ashrit@example.com
# ALERT_EMAIL_FROM=squishygpt@yourdomain.com
